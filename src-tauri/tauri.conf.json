{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diagram Studio",
  "version": "0.1.0",
  "identifier": "com.diagramstudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Diagram Studio",
        "width": 1440,
        "height": 960,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A focused, professional diagram editor",
    "longDescription": "Create clear flowcharts and diagrams in a polished, distraction-free workspace."
  }
}
